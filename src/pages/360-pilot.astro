---
import FAQSection from '../components/FAQSection.astro';
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../keystatic.config';

const reader = createReader(process.cwd(), keystaticConfig);
const [page, faqPage] = await Promise.all([
  reader.singletons.product360.read(),
  reader.singletons.faqPage.read(),
]);
if (!page || !faqPage) throw new Error('360 page content is missing.');

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqPage.faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: { '@type': 'Answer', text: faq.answer },
  })),
};
const features = [
  ['Configure around your organisation', 'Adapt competencies, questionnaires, scales, languages and workflows to different roles, markets and programmes.'],
  ['Invite the right perspectives', 'Collect structured feedback from self, managers, peers, direct reports and relevant internal or external stakeholders.'],
  ['Protect trust by design', 'Apply anonymity thresholds, permissions and governed reporting so participants understand how feedback will be used.'],
  ['Turn insight into development', 'Reveal strengths, blind spots and perception gaps, then connect the findings to meaningful development priorities.'],
  ['Scale with consistency', 'Coordinate complex programmes across business units and countries while preserving local relevance.'],
];
const stats = [
  ['Multi-source', 'feedback architecture'],
  ['Multilingual', 'programme delivery'],
  ['Enterprise-ready', 'governance and scale'],
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />
  <title>{page.metaTitle}</title>
  <meta name="description" content={page.metaDescription} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>
</head>
<body>
  <header class="site-header">
    <a class="brand" href="/" aria-label="aTalent home">a<span>Talent</span></a>
    <nav aria-label="Main navigation">
      <a href="#capabilities">Products</a><a href="#outcomes">Solutions</a><a href="#faq">Resources</a><a href="#ai">AI</a>
    </nav>
    <a class="header-cta" href="#contact">Schedule a Demo</a>
  </header>

  <main>
    <section class="hero">
      <div class="hero-copy">
        <p class="eyebrow">{page.eyebrow}</p>
        <h1>{page.title}</h1>
        <p class="lead">{page.description}</p>
        <div class="actions">
          <a class="button primary" href="#contact">{page.primaryCta}</a>
          <a class="button secondary" href="#capabilities">{page.secondaryCta} <span>→</span></a>
        </div>
      </div>
      <div class="hero-ui" aria-label="Illustration of a 360 feedback report">
        <div class="ui-top"><span>360° Feedback Overview</span><span class="pill">Programme live</span></div>
        <div class="profile"><div class="avatar">AL</div><div><strong>Alex Lee</strong><small>Leadership Programme · APAC</small></div></div>
        <div class="chart">
          <div class="rings"><span>Self</span><b>4.1</b><small>Overall score</small></div>
          <div class="bars">
            <label>Builds trust <i style="--v:88%"></i></label>
            <label>Drives clarity <i style="--v:76%"></i></label>
            <label>Develops others <i style="--v:82%"></i></label>
          </div>
        </div>
      </div>
    </section>

    <section class="stat-band" aria-label="Platform highlights">
      {stats.map(([value,label]) => <div><strong>{value}</strong><span>{label}</span></div>)}
    </section>

    <section class="section intro" id="outcomes">
      <p class="eyebrow">See the whole picture</p>
      <h2>Feedback becomes useful when it creates clarity—not more noise.</h2>
      <p>A well-run 360° programme helps people understand how their intentions are experienced by others. aTalent gives enterprise HR teams the structure to make that insight fair, actionable and relevant across markets.</p>
    </section>

    <section class="section capabilities" id="capabilities">
      <div class="section-heading">
        <p class="eyebrow">Built for complex organisations</p>
        <h2>One programme, shaped around your people.</h2>
      </div>
      <div class="feature-layout">
        <div class="feature-list">
          {features.map(([title,text],index) => (
            <article class:list={['feature', { active: index === 0 }]}>
              <span>0{index + 1}</span><div><h3>{title}</h3><p>{text}</p></div>
            </article>
          ))}
        </div>
        <div class="feature-visual">
          <div class="mini-card"><small>Programme progress</small><strong>82%</strong><div class="progress"><i></i></div></div>
          <div class="source-grid"><span>Self</span><span>Manager</span><span>Peers</span><span>Direct reports</span></div>
          <div class="quote">“The patterns are clear enough to act on—and nuanced enough to discuss.”</div>
        </div>
      </div>
    </section>

    <section class="ai-section" id="ai">
      <div class="ai-copy">
        <p class="eyebrow light">{page.aiLabel}</p>
        <h2>{page.aiHeading}</h2>
        <p>{page.aiDescription}</p>
        <ul><li>Surface recurring themes across qualitative comments</li><li>Support concise, consistent feedback summaries</li><li>Keep permissions, context and human review in the workflow</li></ul>
      </div>
      <div class="ai-ui">
        <div class="spark">✦</div><small>Feedback themes</small>
        <div class="theme"><span>01</span><div><b>Strategic clarity</b><p>Frequently recognised across manager and peer feedback.</p></div></div>
        <div class="theme"><span>02</span><div><b>Coaching consistency</b><p>A recurring opportunity in open-text responses.</p></div></div>
        <p class="guardrail">AI-assisted summary · Review required before sharing</p>
      </div>
    </section>

    <div id="faq">
      <FAQSection label={faqPage.label} heading={faqPage.heading} introduction={faqPage.introduction} faqs={faqPage.faqs} />
    </div>

    <section class="final-cta" id="contact">
      <div><p class="eyebrow light">Ready when you are</p><h2>{page.finalHeading}</h2><p>{page.finalDescription}</p></div>
      <a class="button white" href="mailto:contact@atalent.com">Schedule a Demo</a>
    </section>
  </main>
  <footer><a class="brand inverse" href="/">a<span>Talent</span></a><p>Human insight. Enterprise scale. Responsible AI.</p><small>© aTalent. All rights reserved.</small></footer>
</body>
</html>

<style is:global>
  :root{--ink:#1d1b20;--muted:#68636d;--purple:#68316d;--violet:#8d5b94;--lavender:#f3edf5;--line:#e7e1e8;--cream:#faf8f6}
  *{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;color:var(--ink);font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;background:white}a{color:inherit;text-decoration:none}
  .site-header{position:sticky;top:0;z-index:20;height:76px;padding:0 max(28px,calc((100vw - 1240px)/2));display:flex;align-items:center;gap:48px;background:rgba(255,255,255,.94);border-bottom:1px solid rgba(231,225,232,.8);backdrop-filter:blur(16px)}
  .brand{font-size:27px;font-weight:750;letter-spacing:-1.5px;color:var(--purple)}.brand span{font-weight:350}.site-header nav{display:flex;gap:32px;margin:auto;font-size:14px}.site-header nav a:hover{color:var(--purple)}.header-cta{padding:12px 18px;border-radius:6px;background:var(--purple);color:white;font-size:14px;font-weight:650}
  .hero{min-height:690px;padding:110px max(28px,calc((100vw - 1200px)/2));display:grid;grid-template-columns:1.02fr .98fr;align-items:center;gap:80px;background:radial-gradient(circle at 86% 24%,#f2e7f5 0,transparent 34%),linear-gradient(135deg,#fff 35%,#faf7fb)}
  .eyebrow{margin:0 0 18px;color:var(--purple);font-size:13px;font-weight:750;letter-spacing:.13em;text-transform:uppercase}.eyebrow.light{color:#e9cfee}
  h1{max-width:680px;margin:0;font-size:clamp(48px,5.4vw,76px);line-height:1.04;letter-spacing:-.055em;font-weight:500}h2{margin:0;font-size:clamp(36px,4vw,58px);line-height:1.1;letter-spacing:-.045em;font-weight:480}
  .lead{max-width:640px;margin:28px 0 34px;color:var(--muted);font-size:20px;line-height:1.65}.actions{display:flex;gap:14px;flex-wrap:wrap}.button{display:inline-flex;align-items:center;justify-content:center;min-height:52px;padding:0 24px;border-radius:6px;font-size:15px;font-weight:700}.primary{background:var(--purple);color:#fff}.secondary{border:1px solid var(--line);background:#fff}.secondary span{margin-left:12px}
  .hero-ui{padding:24px;border:1px solid rgba(104,49,109,.12);border-radius:18px;background:rgba(255,255,255,.88);box-shadow:0 28px 80px rgba(70,35,73,.14)}.ui-top,.profile{display:flex;align-items:center;justify-content:space-between}.ui-top{padding-bottom:18px;border-bottom:1px solid var(--line);font-size:13px;font-weight:700}.pill{padding:6px 9px;border-radius:99px;background:#e9f6ed;color:#247341;font-size:11px}.profile{justify-content:flex-start;gap:12px;padding:22px 0}.avatar{width:44px;height:44px;display:grid;place-items:center;border-radius:50%;background:var(--lavender);color:var(--purple);font-weight:750}.profile small{display:block;margin-top:4px;color:var(--muted)}.chart{display:grid;grid-template-columns:160px 1fr;gap:28px;align-items:center;padding:22px;border-radius:12px;background:#faf8fb}.rings{width:150px;height:150px;display:flex;flex-direction:column;align-items:center;justify-content:center;border:18px solid #d9c1de;border-top-color:var(--purple);border-radius:50%;transform:rotate(18deg)}.rings>*{transform:rotate(-18deg)}.rings span,.rings small{font-size:10px;color:var(--muted)}.rings b{font-size:32px}.bars{display:grid;gap:18px}.bars label{font-size:12px}.bars i{display:block;width:var(--v);height:7px;margin-top:7px;border-radius:9px;background:linear-gradient(90deg,var(--purple),#ba8ec0)}
  .stat-band{max-width:1200px;margin:-40px auto 0;padding:26px 34px;display:grid;grid-template-columns:repeat(3,1fr);gap:16px;border-radius:12px;background:#fff;box-shadow:0 18px 60px rgba(39,31,40,.1);position:relative}.stat-band div{padding:8px 24px;border-right:1px solid var(--line)}.stat-band div:last-child{border:0}.stat-band strong,.stat-band span{display:block}.stat-band strong{font-size:20px}.stat-band span{margin-top:6px;color:var(--muted);font-size:13px}
  .section{padding:120px max(28px,calc((100vw - 1200px)/2))}.intro{max-width:1020px;text-align:center}.intro h2{max-width:900px;margin:auto}.intro>p:last-child{max-width:770px;margin:26px auto 0;color:var(--muted);font-size:18px;line-height:1.75}
  .capabilities{background:var(--cream)}.section-heading{max-width:760px;margin-bottom:60px}.feature-layout{display:grid;grid-template-columns:1.15fr .85fr;gap:70px;align-items:start}.feature{display:grid;grid-template-columns:45px 1fr;gap:20px;padding:24px 0;border-top:1px solid var(--line)}.feature>span{color:var(--violet);font-size:12px}.feature h3{margin:0 0 8px;font-size:21px}.feature p{margin:0;color:var(--muted);line-height:1.65}.feature-visual{position:sticky;top:110px;padding:32px;border-radius:18px;background:linear-gradient(145deg,#6a3470,#3d2142);color:white;box-shadow:0 28px 70px rgba(69,35,73,.23)}.mini-card{padding:22px;border-radius:12px;background:rgba(255,255,255,.11)}.mini-card small,.mini-card strong{display:block}.mini-card strong{margin:9px 0;font-size:44px}.progress{height:7px;border-radius:9px;background:rgba(255,255,255,.16)}.progress i{display:block;width:82%;height:100%;border-radius:inherit;background:#e9cfee}.source-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin:18px 0}.source-grid span{padding:14px;border-radius:8px;background:rgba(255,255,255,.09);font-size:12px}.quote{padding:24px;border-left:2px solid #d7addd;font-size:17px;line-height:1.55}
  .ai-section{padding:120px max(28px,calc((100vw - 1200px)/2));display:grid;grid-template-columns:1fr 1fr;gap:90px;align-items:center;color:white;background:linear-gradient(135deg,#211523,#5f2c65)}.ai-copy>p:not(.eyebrow){margin:25px 0;color:#dfd4e1;font-size:18px;line-height:1.7}.ai-copy ul{padding:0;list-style:none}.ai-copy li{padding:13px 0;border-bottom:1px solid rgba(255,255,255,.12)}.ai-copy li:before{content:"✦";margin-right:12px;color:#dcb5e2}.ai-ui{position:relative;padding:34px;border:1px solid rgba(255,255,255,.16);border-radius:18px;background:rgba(255,255,255,.08);backdrop-filter:blur(16px)}.spark{position:absolute;right:24px;top:18px;color:#e5bceb;font-size:28px}.ai-ui>small{text-transform:uppercase;letter-spacing:.12em;color:#d4bdd8}.theme{display:grid;grid-template-columns:42px 1fr;gap:14px;padding:23px 0;border-bottom:1px solid rgba(255,255,255,.12)}.theme>span{width:34px;height:34px;display:grid;place-items:center;border-radius:50%;background:rgba(255,255,255,.1);font-size:11px}.theme b{font-size:17px}.theme p{margin:7px 0 0;color:#d8cdd9;line-height:1.55}.guardrail{margin:20px 0 0;color:#cbb9ce;font-size:11px}
  .final-cta{padding:86px max(28px,calc((100vw - 1200px)/2));display:flex;align-items:center;justify-content:space-between;gap:40px;color:white;background:var(--purple)}.final-cta div{max-width:780px}.final-cta h2{font-size:clamp(34px,4vw,52px)}.final-cta div>p:last-child{font-size:17px;line-height:1.6;color:#eaddea}.white{flex:none;background:#fff;color:var(--purple)}
  footer{padding:48px max(28px,calc((100vw - 1200px)/2));display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:34px;background:#1d171e;color:#cfc5d1}footer .inverse{color:#fff}footer p{font-size:13px}footer small{font-size:11px}
  @media(max-width:850px){.site-header nav{display:none}.site-header{justify-content:space-between}.hero,.feature-layout,.ai-section{grid-template-columns:1fr}.hero{padding-top:70px}.hero-ui{margin-top:0}.feature-visual{position:static}.stat-band{margin:0;border-radius:0}.final-cta{align-items:flex-start;flex-direction:column}footer{grid-template-columns:1fr}.chart{grid-template-columns:1fr}.rings{margin:auto}}
  @media(max-width:560px){.header-cta{display:none}.hero{min-height:auto;padding-block:70px}.stat-band{grid-template-columns:1fr}.stat-band div{border-right:0;border-bottom:1px solid var(--line)}.section,.ai-section{padding-block:84px}.hero-ui{padding:16px}.source-grid{grid-template-columns:1fr}}
</style>
