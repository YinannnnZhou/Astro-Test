---
import { faqs } from '../data/360-faq';
---

<section class="faq" aria-labelledby="faq-title">
  <div class="faq__intro">
    <p class="eyebrow">Frequently asked questions</p>
    <h2 id="faq-title">360 Feedback,<br />clearly explained.</h2>
    <p class="intro-copy">
      Direct answers to the questions enterprise HR teams ask when planning a
      360 Feedback programme.
    </p>
  </div>

  <div class="faq__list">
    {faqs.map((faq, index) => (
      <details class="faq__item" open={index === 0}>
        <summary>
          <span>{faq.question}</span>
          <span class="toggle" aria-hidden="true"></span>
        </summary>
        <div class="answer"><p>{faq.answer}</p></div>
      </details>
    ))}
  </div>
</section>

<style>
  .faq {
    display: grid;
    grid-template-columns: minmax(0, 0.78fr) minmax(0, 1.22fr);
    gap: clamp(3rem, 7vw, 7.5rem);
    max-width: 1200px;
    margin: 0 auto;
    padding: clamp(5rem, 9vw, 8.5rem) 1.5rem;
  }

  .faq__intro {
    position: sticky;
    top: 2rem;
    align-self: start;
  }

  .eyebrow {
    margin: 0 0 1rem;
    color: #7554ff;
    font-size: 0.76rem;
    font-weight: 750;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  h2 {
    margin: 0;
    color: #17131d;
    font-size: clamp(2.4rem, 5vw, 4.6rem);
    font-weight: 520;
    letter-spacing: -0.055em;
    line-height: 0.98;
  }

  .intro-copy {
    max-width: 29rem;
    margin: 1.6rem 0 0;
    color: #696373;
    font-size: 1.04rem;
    line-height: 1.72;
  }

  .faq__list { border-top: 1px solid #ddd8e5; }
  .faq__item { border-bottom: 1px solid #ddd8e5; }

  summary {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 2rem;
    align-items: center;
    padding: 1.7rem 0;
    color: #292330;
    cursor: pointer;
    font-size: clamp(1.06rem, 1.5vw, 1.28rem);
    font-weight: 620;
    line-height: 1.42;
    list-style: none;
  }

  summary::-webkit-details-marker { display: none; }
  summary:focus-visible {
    border-radius: 0.25rem;
    outline: 3px solid rgb(117 84 255 / 25%);
    outline-offset: 0.35rem;
  }

  .toggle {
    position: relative;
    width: 1.65rem;
    height: 1.65rem;
    border: 1px solid #bbb1cb;
    border-radius: 50%;
  }

  .toggle::before,
  .toggle::after {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 0.7rem;
    height: 1px;
    background: #7554ff;
    content: '';
    transform: translate(-50%, -50%);
  }

  .toggle::after {
    transform: translate(-50%, -50%) rotate(90deg);
    transition: transform 180ms ease;
  }

  details[open] .toggle::after {
    transform: translate(-50%, -50%) rotate(0deg);
  }

  .answer { padding: 0 3.6rem 1.85rem 0; }
  .answer p {
    margin: 0;
    color: #625b69;
    font-size: 1rem;
    line-height: 1.78;
  }

  @media (max-width: 760px) {
    .faq { grid-template-columns: 1fr; gap: 3.5rem; }
    .faq__intro { position: static; }
    summary { gap: 1rem; }
    .answer { padding-right: 0; }
  }
</style>
