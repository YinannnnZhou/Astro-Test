---
import FAQSection from '../components/FAQSection.astro';
import CapabilitiesSection from '../components/CapabilitiesSection.astro';
import Hero360 from '../components/Hero360.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Smart360 from '../components/Smart360.astro';
import MotionRuntime from '../components/MotionRuntime.astro';
import ProofSection from '../components/ProofSection.astro';
import TestimonialsSection from '../components/TestimonialsSection.astro';
import FinalCta from '../components/FinalCta.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../keystatic.config';

const reader = createReader(process.cwd(), keystaticConfig);
const [faqPage, capabilitiesPage, smart360, testimonials360, product360] = await Promise.all([
  reader.singletons.faqPage.read(), reader.singletons.capabilities360.read(), reader.singletons.smart360.read(),
  reader.singletons.testimonials360.read(), reader.singletons.product360.read(),
]);
if (!faqPage || !capabilitiesPage || !smart360 || !testimonials360 || !product360) throw new Error('360 page content is missing.');

const organizationSchema = { '@context':'https://schema.org','@type':'Organization',name:'aTalent',legalName:'aTalent SG PTE LTD',url:'https://www.atalent.com',logo:'https://assets.atalent.com/logo.png',foundingDate:'2015',areaServed:'Worldwide',description:'aTalent is an AI-powered enterprise talent management platform helping organizations manage performance, develop talent, and drive business outcomes.' };
const breadcrumbSchema = { '@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[
  {'@type':'ListItem',position:1,name:'Home',item:'https://www.atalent.com/'},
  {'@type':'ListItem',position:2,name:'Products',item:'https://www.atalent.com/products'},
  {'@type':'ListItem',position:3,name:'aTalent 360° Feedback',item:'https://www.atalent.com/products/360-feedback'},
] };
const productDescription = product360.metaDescription || product360.description;
const softwareSchema = { '@context':'https://schema.org','@type':'SoftwareApplication',name:'aTalent 360° Feedback',applicationCategory:'BusinessApplication',applicationSubCategory:'Performance Management',description:productDescription,url:'https://www.atalent.com/products/360-feedback',operatingSystem:'Web',featureList:capabilitiesPage.features.map((feature)=>feature.title),provider:{'@type':'Organization',name:'aTalent',url:'https://www.atalent.com'} };
const productSchema = { '@context':'https://schema.org','@type':'Product',name:'aTalent 360° Feedback',description:productDescription,url:'https://www.atalent.com/products/360-feedback',image:product360.heroImageUrl,brand:{'@type':'Brand',name:'aTalent'} };
const faqSchema = { '@context':'https://schema.org','@type':'FAQPage',mainEntity:faqPage.faqs.map((faq)=>({'@type':'Question',name:faq.question,acceptedAnswer:{'@type':'Answer',text:faq.answer}})) };
const schemas = [organizationSchema,breadcrumbSchema,softwareSchema,productSchema,faqSchema];
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={product360.metaDescription} />
    <link rel="canonical" href="https://www.atalent.com/products/360-feedback" />
    <title>{product360.metaTitle}</title>
    <script is:inline>
      (() => { const saved=localStorage.getItem('themeMode'); document.documentElement.dataset.theme=saved||(matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light'); })();
    </script>
    {schemas.map((schema)=><script type="application/ld+json" set:html={JSON.stringify(schema)}></script>)}
    <style is:global>
      html{box-sizing:border-box;scroll-behavior:smooth;-webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale;-webkit-text-size-adjust:100%}*,*::before,*::after{box-sizing:inherit}
      body{margin:0;overflow-x:hidden;background:#fff;color:#1e2022;font:400 1rem/1.5 Inter,Arial,sans-serif;transition:background-color 260ms ease,color 260ms ease}button,input,textarea,select{font:inherit}
      html[data-theme='dark'] body{background:#222b45;color:#eeeef0}@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
    </style>
  </head>
  <body>
    <SiteHeader />
    <main>
      <Hero360 title={product360.title} description={product360.description} imageUrl={product360.heroImageUrl} imageAlt={product360.heroImageAlt} />
      <ProofSection heading={product360.proofHeading} description={product360.proofDescription} ctaLabel={product360.proofCtaLabel} ctaHref="/contact" stats={product360.proofStats} />
      <CapabilitiesSection features={capabilitiesPage.features} />
      <Smart360 title={smart360.title} intro={smart360.intro} featureList={smart360.featureList} slides={smart360.slides} />
      <TestimonialsSection heading={testimonials360.heading} description={testimonials360.description} aiCtaLabel={testimonials360.aiCtaLabel} aiCtaHref={testimonials360.aiCtaHref} testimonials={testimonials360.testimonials} />
      <FAQSection label={faqPage.label} heading={faqPage.heading} introduction={faqPage.introduction} faqs={faqPage.faqs} />
      <FinalCta heading={product360.finalHeading} description={product360.finalDescription} ctaLabel={product360.primaryCta} ctaHref="/contact" />
    </main>
    <SiteFooter copyright={product360.footerCopyright} />
    <MotionRuntime />
  </body>
</html>
