---
import FAQSection from '../components/FAQSection.astro';
import CapabilitiesSection from '../components/CapabilitiesSection.astro';
import Smart360 from '../components/Smart360.astro';
import MotionRuntime from '../components/MotionRuntime.astro';
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../keystatic.config';
import originalPage from '../snapshots/atalent-360.html?raw';
import originalStyles from '../styles/atalent-original.css?raw';

const reader = createReader(process.cwd(), keystaticConfig);
const [faqPage, capabilitiesPage, smart360] = await Promise.all([
  reader.singletons.faqPage.read(),
  reader.singletons.capabilities360.read(),
  reader.singletons.smart360.read(),
]);

if (!faqPage || !capabilitiesPage || !smart360) {
  throw new Error('360 page content is missing.');
}

const capabilityStart = '<div class="MuiBox-root css-0"><div class="MuiBox-root css-18033jt"><div class="MuiBox-root css-ib9iq6">';
const capabilityEnd = '<div class="MuiBox-root css-0"><div class="MuiBox-root css-18033jt"><div class="MuiBox-root css-touz9j ">';
const smartEnd = '<div class="MuiBox-root css-0"><div class="MuiBox-root css-18033jt"><div class="MuiBox-root css-0"><div class="MuiBox-root css-d32wgk">';
const capabilityStartIndex = originalPage.indexOf(capabilityStart);
const capabilityEndIndex = originalPage.indexOf(capabilityEnd, capabilityStartIndex);
const smartEndIndex = originalPage.indexOf(smartEnd, capabilityEndIndex);

if (capabilityStartIndex < 0 || capabilityEndIndex < 0 || smartEndIndex < 0) {
  throw new Error('Capability section boundaries are missing from the page snapshot.');
}

const beforeCapabilities = originalPage.slice(0, capabilityStartIndex);
const afterSmart = originalPage.slice(smartEndIndex);
const [betweenSmartAndFaq, afterFaq] = afterSmart.split('<!--FAQ_SLOT-->');

if (!betweenSmartAndFaq || !afterFaq) {
  throw new Error('FAQ insertion point is missing from the aTalent page snapshot.');
}

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqPage.faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: { '@type': 'Answer', text: faq.answer },
  })),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Gather multi-source feedback, identify development priorities and explore common questions about enterprise 360-degree feedback." />
    <title>360 Degree Feedback Platform for Employee Insights | aTalent</title>
    <script is:inline>
      (() => {
        const saved = localStorage.getItem('themeMode');
        const mode = saved || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        document.documentElement.dataset.theme = mode;
      })();
    </script>
    <link rel="stylesheet" href="https://www.atalent.com/_next/static/css/d829c41e8156d33a.css" />
    <Fragment set:html={`<style>${originalStyles}</style>`} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>
    <style is:global>
      html { scroll-behavior: smooth; }
      body { margin: 0; }
    
      header.css-ibyuam {
        transition: background-color 220ms ease, box-shadow 220ms ease, backdrop-filter 220ms ease;
      }
    
      header.css-ibyuam.pilot-nav-scrolled {
        background: rgba(255, 255, 255, 0.96) !important;
        box-shadow: 0 8px 24px rgba(30, 32, 34, 0.10) !important;
        backdrop-filter: blur(12px);
      }
    
      .pilot-nav-holder {
        position: relative;
      }
    
      .pilot-nav-menu {
        display: block;
        position: absolute;
        top: 100%;
        left: 50%;
        z-index: 1500;
        min-width: 230px;
        margin: 4px 0 0;
        padding: 8px 0;
        visibility: hidden;
        opacity: 0;
        pointer-events: none;
        transform: translate(-50%, -8px) scale(0.98);
        transform-origin: top center;
        transition: opacity 180ms ease, transform 180ms ease, visibility 180ms;
        list-style: none;
        border-top: 3px solid #69306d;
        border-radius: 0 0 8px 8px;
        background: #fff;
        box-shadow: 0 16px 36px rgba(30, 32, 34, 0.14);
      }
    
      .pilot-nav-menu::before {
        position: absolute;
        right: 0;
        bottom: 100%;
        left: 0;
        height: 8px;
        content: '';
      }

      .pilot-nav-holder:hover > .pilot-nav-menu,
      .pilot-nav-holder:focus-within > .pilot-nav-menu,
      .pilot-nav-holder.menu-open > .pilot-nav-menu {
        visibility: visible;
        opacity: 1;
        pointer-events: auto;
        transform: translate(-50%, 0) scale(1);
      }

      .pilot-nav-menu-products {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 32px;
        width: min(600px, calc(100vw - 32px));
        max-width: 600px;
        padding: 16px;
        box-sizing: border-box;
      }

      .pilot-nav-group {
        min-width: 0;
        list-style: none;
      }

      .pilot-nav-group-title {
        display: block;
        padding: 8px 16px;
        color: #6b7c90;
        font: 700 0.875rem/1.43 Inter, sans-serif;
      }

      .pilot-nav-menu-company,
      .pilot-nav-menu-standard {
        width: min(300px, calc(100vw - 32px));
        max-width: 300px;
        padding: 16px;
        box-sizing: border-box;
      }

      .pilot-nav-company-group {
        margin: 8px 0;
        list-style: none;
      }

      .pilot-nav-company-list {
        margin: 0;
        padding: 0 0 0 16px;
        list-style: none;
      }

      html[data-theme='dark'] body {
        background: #222b45;
        color: #eeeef0;
      }

      html[data-theme='dark'] header.css-ibyuam,
      html[data-theme='dark'] header.css-ibyuam.pilot-nav-scrolled {
        background: rgba(34, 43, 69, 0.96) !important;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.22) !important;
      }

      html[data-theme='dark'] .MuiTypography-root,
      html[data-theme='dark'] .capabilities-native,
      html[data-theme='dark'] .capability-copy h2,
      html[data-theme='dark'] .capability-copy p,
      html[data-theme='dark'] .faq-pilot,
      html[data-theme='dark'] .faq-heading h2,
      html[data-theme='dark'] .faq-item summary {
        color: #eeeef0 !important;
      }

      html[data-theme='dark'] .css-19101ww,
      html[data-theme='dark'] .css-1fgqj6e,
      html[data-theme='dark'] .capabilities-native,
      html[data-theme='dark'] .faq-pilot {
        background: #1a2138 !important;
      }

      html[data-theme='dark'] .MuiPaper-root,
      html[data-theme='dark'] .pilot-nav-menu,
      html[data-theme='dark'] .smart-card {
        background: #2d3748 !important;
        color: #eeeef0 !important;
      }

      html[data-theme='dark'] .pilot-nav-menu a,
      html[data-theme='dark'] .pilot-nav-group-title {
        color: #eeeef0;
      }

      html[data-theme='dark'] .pilot-nav-group-title,
      html[data-theme='dark'] .faq-heading > p:last-child,
      html[data-theme='dark'] .faq-answer p,
      html[data-theme='dark'] .smart-aside > div > p {
        color: #aeb0b4 !important;
      }

      html[data-theme='dark'] .smart360 {
        background: #1a2138;
        color: #eeeef0;
      }

      html[data-theme='dark'] .capability-media img {
        filter: brightness(0.8);
      }

      html[data-theme='dark'] .faq-list,
      html[data-theme='dark'] .faq-item {
        border-color: rgba(255, 255, 255, 0.12);
      }

      html[data-theme='dark'] .pilot-nav-menu {
        border-top-color: #1976d2;
      }

      html[data-theme='dark'] .pilot-nav-menu a[aria-current='page'] {
        color: #1976d2;
        background: rgba(25, 118, 210, 0.10);
      }

      html[data-theme='dark'] .pilot-nav-menu a:hover,
      html[data-theme='dark'] .pilot-nav-menu a:focus-visible {
        color: #1976d2;
        background: rgba(25, 118, 210, 0.20);
      }

      html[data-theme='dark'] .css-x4iqch,
      html[data-theme='dark'] .css-o6p3jo,
      html[data-theme='dark'] .pilot-mobile-cta {
        background: #1976d2 !important;
        color: #fff !important;
      }

      html[data-theme='dark'] .faq-label {
        color: #1976d2 !important;
        background: transparent !important;
      }

      html[data-theme='dark'] .faq-toggle::before,
      html[data-theme='dark'] .faq-toggle::after {
        background-color: #1976d2;
      }

      html[data-theme='dark'] .smart-dots button.active {
        background: #1976d2;
      }

      html[data-theme='dark'] .css-1vkac6x path {
        fill: #222b45;
      }

      html[data-theme='dark'] .smart360 {
        background: #0d47a1;
      }

      html[data-theme='dark'] .smart-card,
      html[data-theme='dark'] .MuiPaper-root {
        background: #222b45 !important;
      }

      .css-x4iqch,
      .css-o6p3jo,
      .pilot-mobile-cta {
        transition: background-color 180ms ease, box-shadow 180ms ease, transform 180ms ease !important;
      }

      .css-x4iqch:hover,
      .css-o6p3jo:hover,
      .pilot-mobile-cta:hover {
        background: #2f6ad9 !important;
        box-shadow: 0 6px 16px rgba(47, 106, 217, 0.28) !important;
        transform: translateY(-1px);
      }

      html[data-theme='dark'] .css-x4iqch:hover,
      html[data-theme='dark'] .css-o6p3jo:hover,
      html[data-theme='dark'] .pilot-mobile-cta:hover {
        background: #0d47a1 !important;
        box-shadow: 0 6px 16px rgba(0, 0, 0, 0.28) !important;
      }

      .css-x4iqch:focus-visible,
      .css-o6p3jo:focus-visible,
      .pilot-mobile-cta:focus-visible {
        outline: 3px solid rgba(105, 48, 109, 0.28);
        outline-offset: 3px;
      }

      html[data-theme='dark'] .css-x4iqch:focus-visible,
      html[data-theme='dark'] .css-o6p3jo:focus-visible,
      html[data-theme='dark'] .pilot-mobile-cta:focus-visible {
        outline-color: rgba(25, 118, 210, 0.42);
      }
    
      .pilot-nav-menu a {
        display: block;
        margin: 2px 0;
        padding: 8px 16px;
        border-radius: 8px;
        color: #1e2022;
        font: 400 0.875rem/1.43 Inter, sans-serif;
        text-decoration: none;
        white-space: nowrap;
      }
    
      .pilot-nav-menu a[aria-current="page"] {
        color: #69306d;
        background: rgba(105, 48, 109, 0.10);
        font-weight: 600;
      }

      .pilot-nav-menu a:hover,
      .pilot-nav-menu a:focus-visible {
        color: #69306d;
        background: rgba(105, 48, 109, 0.20);
        outline: none;
      }
    
      .css-ijq4xa {
        position: relative;
      }
    
      .pilot-mobile-menu {
        position: absolute;
        top: calc(100% + 10px);
        right: 0;
        z-index: 1600;
        width: min(330px, calc(100vw - 32px));
        max-height: calc(100vh - 100px);
        overflow: auto;
        padding: 16px;
        border-top: 3px solid #69306d;
        border-radius: 0 0 10px 10px;
        background: #fff;
        box-shadow: 0 16px 36px rgba(30, 32, 34, 0.16);
      }
    
      .pilot-mobile-menu[hidden] {
        display: none;
      }
    
      .pilot-mobile-menu a,
      .pilot-mobile-heading {
        display: block;
        margin: 0;
        padding: 9px 8px;
        color: #1e2022;
        font: 400 0.9375rem/1.4 Inter, sans-serif;
        text-decoration: none;
      }
    
      .pilot-mobile-heading {
        margin-top: 8px;
        color: #69306d;
        font-weight: 600;
      }
    
      .pilot-mobile-cta {
        margin-top: 12px;
        border-radius: 6px;
        color: #fff !important;
        background: #69306d;
        text-align: center;
      }
    
      .slick-slider .slick-slide {
        transition: opacity 180ms ease;
      }
    
      @media (prefers-reduced-motion: reduce) {
        header.css-ibyuam,
        .slick-slider .slick-slide {
          transition: none;
        }
      }
    </style>
  </head>
  <body>
    <Fragment set:html={beforeCapabilities} />
    <CapabilitiesSection features={capabilitiesPage.features} />
    <Smart360 title={smart360.title} intro={smart360.intro} featureList={smart360.featureList} slides={smart360.slides} />
    <Fragment set:html={betweenSmartAndFaq} />
    <FAQSection
      label={faqPage.label}
      heading={faqPage.heading}
      introduction={faqPage.introduction}
      faqs={faqPage.faqs}
    />
    <Fragment set:html={afterFaq} />

    <MotionRuntime />

    <script is:inline>
      (() => {
        const themeButton = document.querySelector('button[aria-label="Dark mode toggler"]');
        const logo = document.querySelector('header img[alt="aTalent Logo"]');
        const applyTheme = (mode) => {
          document.documentElement.dataset.theme = mode;
          localStorage.setItem('themeMode', mode);
          themeButton?.setAttribute('aria-pressed', String(mode === 'dark'));
          themeButton?.setAttribute('title', mode === 'dark' ? 'Switch to light mode' : 'Switch to dark mode');
          if (logo) logo.src = mode === 'dark'
            ? 'https://assets.atalent.com/Uploads/a_Talent_logo_white_0b77096005.svg'
            : 'https://assets.atalent.com/Uploads/a_Talent_logo_Dark_e97b353bb7.svg';
        };
        applyTheme(document.documentElement.dataset.theme || 'light');
        themeButton?.addEventListener('click', () => {
          applyTheme(document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark');
        });

        const header = document.querySelector('header.css-ibyuam');
        const setHeaderState = () => {
          header?.classList.toggle('pilot-nav-scrolled', window.scrollY > 12);
        };
        setHeaderState();
        window.addEventListener('scroll', setHeaderState, { passive: true });

        const menus = {
          products: [
            ['OKR', '/products/OKR'],
            ['KPI', '/products/KPI'],
            ['360° Feedback', '/products/360-feedback'],
            ['Talent Review', '/products/talent-review'],
            ['Talent Pool', '/products/talent-pool'],
            ['Skill', '/products/skill'],
            ['IDP', '/products/IDP'],
            ['Succession', '/products/succession'],
            ['Learn', '/partner/docebo'],
            ['Talent Marketplace', '/products/talent-marketplace'],
          ],
          solutions: [['Customer Stories', '/customer-stories']],
          company: [
            ['About aTalent', '/about-us'],
            ['Docebo', '/partner/docebo'],
            ['Cornerstone OnDemand', '/partner/cornerstone-ondemand'],
            ['LinkedIn', '/partner/LinkedIn'],
            ['AWS', '/partner/AWS'],
            ['Blog', '/resources/blog'],
            ['News', '/resources/news'],
            ['Security & Compliance', '/security-compliance'],
            ['Trailblazer', 'https://trailblazer.atalent.com/'],
          ],
        };

        Object.entries(menus).forEach(([name, items]) => {
          const trigger = document.querySelector(`[aria-describedby="${name}"], [aria-describedby="${name[0].toUpperCase() + name.slice(1)}"]`);
          const holder = trigger?.closest('.css-0');
          if (!trigger || !holder || holder.querySelector('.pilot-nav-menu')) return;

          holder.classList.add('pilot-nav-holder');
          trigger.setAttribute('role', 'button');
          trigger.setAttribute('tabindex', '0');
          trigger.setAttribute('aria-haspopup', 'true');

          const menu = document.createElement('ul');
          menu.className = 'pilot-nav-menu';
          menu.setAttribute('aria-label', `${name} menu`);

          const appendLink = (parent, label, href) => {
            const item = document.createElement('li');
            const link = document.createElement('a');
            link.href = href;
            link.textContent = label;
            if (href.startsWith('http')) {
              link.target = '_blank';
              link.rel = 'noopener noreferrer';
            }
            const currentPath = location.pathname.toLowerCase().replace(/\/$/, '');
            const targetPath = href.toLowerCase().replace(/\/$/, '');
            const isPilot360 = currentPath === '/360-pilot' && targetPath === '/products/360-feedback';
            if (currentPath === targetPath || isPilot360) {
              link.setAttribute('aria-current', 'page');
            }
            item.appendChild(link);
            parent.appendChild(item);
          };

          if (name === 'products') {
            menu.classList.add('pilot-nav-menu-products');
            [
              ['Performance', items.slice(0, 4)],
              ['Development', items.slice(4)],
            ].forEach(([heading, groupItems]) => {
              const group = document.createElement('li');
              group.className = 'pilot-nav-group';
              const title = document.createElement('span');
              title.className = 'pilot-nav-group-title';
              title.textContent = heading;
              group.appendChild(title);
              const list = document.createElement('ul');
              list.style.margin = '0';
              list.style.padding = '0';
              list.style.listStyle = 'none';
              groupItems.forEach(([label, href]) => appendLink(list, label, href));
              group.appendChild(list);
              menu.appendChild(group);
            });
          } else if (name === 'company') {
            menu.classList.add('pilot-nav-menu-company');
            appendLink(menu, items[0][0], items[0][1]);
            [
              ['Partner', items.slice(1, 5)],
              ['Resources', items.slice(5, 7)],
            ].forEach(([heading, groupItems]) => {
              const group = document.createElement('li');
              group.className = 'pilot-nav-company-group';
              const title = document.createElement('span');
              title.className = 'pilot-nav-group-title';
              title.textContent = heading;
              group.appendChild(title);
              const list = document.createElement('ul');
              list.className = 'pilot-nav-company-list';
              groupItems.forEach(([label, href]) => appendLink(list, label, href));
              group.appendChild(list);
              menu.appendChild(group);
            });
            items.slice(7).forEach(([label, href]) => appendLink(menu, label, href));
          } else {
            menu.classList.add('pilot-nav-menu-standard');
            items.forEach(([label, href]) => appendLink(menu, label, href));
          }

          let closeTimer;
          const openMenu = () => {
            window.clearTimeout(closeTimer);
            holder.classList.add('menu-open');
            trigger.setAttribute('aria-expanded', 'true');
          };
          const closeMenu = () => {
            window.clearTimeout(closeTimer);
            closeTimer = window.setTimeout(() => {
              holder.classList.remove('menu-open');
              trigger.setAttribute('aria-expanded', 'false');
            }, 150);
          };

          trigger.setAttribute('aria-expanded', 'false');
          trigger.addEventListener('mouseenter', openMenu);
          holder.addEventListener('mouseenter', openMenu);
          holder.addEventListener('mouseleave', closeMenu);
          trigger.addEventListener('click', (event) => {
            event.preventDefault();
            holder.classList.contains('menu-open') ? closeMenu() : openMenu();
          });
          trigger.addEventListener('keydown', (event) => {
            if (event.key === 'Enter' || event.key === ' ') {
              event.preventDefault();
              openMenu();
              menu.querySelector('a')?.focus();
            }
            if (event.key === 'Escape') closeMenu();
          });

          holder.appendChild(menu);
        });

        const mobileButton = document.querySelector('button[aria-label="Menu"]');
        const mobileHolder = mobileButton?.closest('.css-ijq4xa');
        if (mobileButton && mobileHolder && !mobileHolder.querySelector('.pilot-mobile-menu')) {
          const panel = document.createElement('div');
          panel.className = 'pilot-mobile-menu';
          panel.hidden = true;

          Object.entries(menus).forEach(([name, items]) => {
            const heading = document.createElement('p');
            heading.className = 'pilot-mobile-heading';
            heading.textContent = name[0].toUpperCase() + name.slice(1);
            panel.appendChild(heading);
            items.forEach(([label, href]) => {
              const link = document.createElement('a');
              link.href = href;
              link.textContent = label;
              panel.appendChild(link);
            });
          });

          const ai = document.createElement('a');
          ai.href = '/ai';
          ai.textContent = 'AI';
          panel.appendChild(ai);

          const demo = document.createElement('a');
          demo.href = '/contact';
          demo.textContent = 'Schedule a Demo';
          demo.className = 'pilot-mobile-cta';
          panel.appendChild(demo);

          mobileHolder.appendChild(panel);
          mobileButton.setAttribute('aria-expanded', 'false');
          mobileButton.addEventListener('click', () => {
            const open = panel.hidden;
            panel.hidden = !open;
            mobileButton.setAttribute('aria-expanded', String(open));
          });

          document.addEventListener('click', (event) => {
            if (!mobileHolder.contains(event.target)) {
              panel.hidden = true;
              mobileButton.setAttribute('aria-expanded', 'false');
            }
          });
        }

        const slider = document.querySelector('.slick-slider');
        if (slider) {
          const slides = [...slider.querySelectorAll('.slick-slide:not(.slick-cloned)')]
            .filter((slide) => ['0', '1'].includes(slide.getAttribute('data-index')));
          const track = slider.querySelector('.slick-track');
          const list = slider.querySelector('.slick-list');
          let active = 0;

          if (track) {
            track.style.width = '100%';
            track.style.transform = 'none';
          }
          if (list) list.style.overflow = 'hidden';

          const render = () => {
            slides.forEach((slide, index) => {
              slide.style.display = index === active ? 'block' : 'none';
              slide.style.width = '100%';
              slide.setAttribute('aria-hidden', String(index !== active));
            });
            slider.querySelectorAll('.css-1w1g3zq button').forEach((button, index) => {
              button.setAttribute('aria-label', `Show AI feature ${(index % 2) + 1}`);
              button.setAttribute('aria-pressed', String(index % 2 === active));
            });
          };

          slider.querySelectorAll('.css-1w1g3zq button').forEach((button, index) => {
            button.addEventListener('click', () => {
              active = index % 2;
              render();
            });
          });
          render();
        }
      })();
    </script>
  </body>
</html>
