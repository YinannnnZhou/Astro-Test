---
interface Props { copyright: string; }
const { copyright } = Astro.props;
---

<footer class="site-footer"><p>{copyright}</p></footer>

<style>
  .site-footer { width:100%; max-width:1236px; margin:0 auto; padding:32px 16px; box-sizing:border-box; }
  .site-footer p { min-height:24px; margin:0; color:#677788; text-align:center; font:500 .875rem/1.57 Inter,sans-serif; }
  :global(html[data-theme='dark']) .site-footer p { color:#aeb0b4; }
  @media(max-width:899px){.site-footer{max-width:720px}}
</style>
