---
interface Props {
  title: string;
  description: string;
  imageUrl: string;
  imageAlt: string;
}
const { title, description, imageUrl, imageAlt } = Astro.props;
---

<section class="hero-native">
  <div class="hero-container">
    <div class="hero-grid">
      <div class="hero-copy" data-aos="fade-right" data-aos-delay="380">
        <h1>{title}</h1>
        <p>{description}</p>
      </div>
      <div class="hero-media">
        <img src={imageUrl} alt={imageAlt} fetchpriority="high" decoding="sync" loading="eager" />
      </div>
    </div>
  </div>
  <svg class="hero-wave" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1920 100.1" aria-hidden="true">
    <path d="M0,0c0,0,934.4,93.4,1920,0v100.1H0L0,0z"></path>
  </svg>
</section>

<style>
  .hero-native{position:relative;min-height:auto;margin-top:-110px;padding-top:110px;background:#f7faff;color:#1e2022}
  .hero-container{position:relative;z-index:1;width:100%;max-width:1236px;margin:0 auto;padding:48px 16px;box-sizing:border-box}
  .hero-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));align-items:center;gap:32px}
  .hero-copy{width:100%;text-align:left}.hero-copy h1{display:inline-block;margin:0;color:#1e2022;font-family:Inter,sans-serif;font-size:3.75rem;font-weight:700;line-height:1.167}
  .hero-copy p{margin:16px 0 0;color:#1e2022;font-family:Inter,sans-serif;font-size:1.25rem;font-weight:400;line-height:1.6}
  .hero-media{display:flex;width:100%;height:100%;align-items:center;justify-content:center}.hero-media img{display:block;width:100%;height:auto;object-fit:cover}
  .hero-wave{display:block;width:100%;height:auto;margin-bottom:-40px}.hero-wave path{fill:#fff}
  :global(html[data-theme='dark']) .hero-native{background:#1a2138;color:#eeeef0}
  :global(html[data-theme='dark']) .hero-copy h1,:global(html[data-theme='dark']) .hero-copy p{color:#eeeef0}
  :global(html[data-theme='dark']) .hero-wave path{fill:#222b45}
  @media(max-width:899px){.hero-container{padding:32px 16px}.hero-grid{grid-template-columns:1fr}.hero-copy h1{font-size:2.8rem}}
  @media(max-width:599px){.hero-container{padding:16px}.hero-copy h1{font-size:2.4rem}.hero-copy p{font-size:1.125rem}}
</style>
