---
type FAQ = {
  question: string;
  answer: string;
};

interface Props {
  label: string;
  heading: string;
  introduction: string;
  faqs: readonly FAQ[];
}

const { label, heading, introduction, faqs } = Astro.props;
---

<section class="faq-pilot" aria-labelledby="faq-title">
  <div class="faq-container">
    <div class="faq-heading">
      <p class="faq-label">{label}</p>
      <h2 id="faq-title">{heading}</h2>
      <p>{introduction}</p>
    </div>

    <div class="faq-list">
      {faqs.map((faq, index) => (
        <details class="faq-item" open={index === 0}>
          <summary>
            <span>{faq.question}</span>
            <span class="faq-toggle" aria-hidden="true"></span>
          </summary>
          <div class="faq-answer"><p>{faq.answer}</p></div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq-pilot {
    padding: 96px 0 112px;
    background: #f7f8fb;
    color: #1e2022;
    font-family: Inter, sans-serif;
  }

  .faq-container {
    width: min(1204px, calc(100% - 48px));
    margin: 0 auto;
  }

  .faq-heading {
    max-width: 760px;
    margin-bottom: 48px;
  }

  .faq-label {
    margin: 0 0 12px;
    color: #69306d;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  .faq-heading h2 {
    margin: 0 0 14px;
    color: #1e2022;
    font-size: clamp(28px, 2.4vw, 38px);
    font-weight: 400;
    line-height: 1.25;
  }

  .faq-heading > p:last-child {
    margin: 0;
    color: #6c757d;
    font-size: 17px;
    line-height: 1.7;
  }

  .faq-list { border-top: 1px solid #dfe3e8; }
  .faq-item { border-bottom: 1px solid #dfe3e8; }

  summary {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 24px;
    align-items: center;
    padding: 25px 0;
    color: #1e2022;
    cursor: pointer;
    font-size: 18px;
    font-weight: 500;
    line-height: 1.55;
    list-style: none;
  }

  summary::-webkit-details-marker { display: none; }

  summary:focus-visible {
    border-radius: 4px;
    outline: 3px solid rgb(105 48 109 / 22%);
    outline-offset: 5px;
  }

  .faq-toggle {
    position: relative;
    width: 28px;
    height: 28px;
    border: 1px solid #b7a8ba;
    border-radius: 50%;
  }

  .faq-toggle::before,
  .faq-toggle::after {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 10px;
    height: 1px;
    background: #69306d;
    content: '';
    transform: translate(-50%, -50%);
  }

  .faq-toggle::after {
    transform: translate(-50%, -50%) rotate(90deg);
    transition: transform 180ms ease;
  }

  details[open] .faq-toggle::after {
    transform: translate(-50%, -50%) rotate(0deg);
  }

  .faq-answer {
    max-width: 930px;
    padding: 0 52px 28px 0;
  }

  .faq-answer p {
    margin: 0;
    color: #6c757d;
    font-size: 16px;
    line-height: 1.75;
  }
  :global(html[data-theme='dark']) .faq-pilot { background:#1a2138; color:#eeeef0; }
  :global(html[data-theme='dark']) .faq-heading h2,
  :global(html[data-theme='dark']) .faq-item summary { color:#eeeef0; }
  :global(html[data-theme='dark']) .faq-heading > p:last-child,
  :global(html[data-theme='dark']) .faq-answer p { color:#aeb0b4; }
  :global(html[data-theme='dark']) .faq-label { color:#1976d2; }
  :global(html[data-theme='dark']) .faq-list,
  :global(html[data-theme='dark']) .faq-item { border-color:rgba(255,255,255,.12); }
  :global(html[data-theme='dark']) .faq-toggle::before,
  :global(html[data-theme='dark']) .faq-toggle::after { background:#1976d2; }

  @media (max-width: 600px) {
    .faq-pilot { padding: 72px 0 80px; }
    .faq-container { width: min(100% - 32px, 1204px); }
    .faq-heading { margin-bottom: 36px; }
    summary { padding: 22px 0; font-size: 17px; }
    .faq-answer { padding-right: 0; }
  }
</style>
